{
  "name": "epubforge",
  "version": "1.0.0",
  "description": "Native professional EPUB toolkit with embedded React UI",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "native": "go run ./cmd/epubforge",
    "native:build": "node scripts/build.js windows",
    "native:build:mac": "node scripts/build.js mac",
    "native:build:linux": "node scripts/build.js linux",
    "native:build:all": "node scripts/build.js all",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "lucide-react": "^1.16.0",
    "mammoth": "^1.12.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "vite": "^8.0.13",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3"
  }
}
